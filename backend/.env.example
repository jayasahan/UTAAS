PORT=4000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=utaas_user
DB_PASSWORD=utaas_secure_password
DB_DATABASE=utaas_db

# Security & JWT
# NOTE: In production (NODE_ENV=production), JWT_SECRET must be explicitly set,
# must NOT be the default development secret, and must be at least 32 characters long.
JWT_SECRET=utaas_development_super_secret_jwt_key_2026
JWT_EXPIRES_IN=1d

# CORS Allowed Origins (comma-separated list of allowed origins)
# In production, this must be explicitly set to trusted frontend origins.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
